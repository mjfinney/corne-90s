#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <behaviors/num_word.dtsi>
#include <zmk-helpers/helper.h>
#include "zmk-helpers/key-labels/42.h"

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2
// Layers
#define DEFAULT 0
#define SYM     1
#define NUM     2
#define NAV     3
#define FN      4

/* Left-hand HRMs. */
ZMK_HOLD_TAP(hml,
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_R THUMBS>;
    hold-trigger-on-release;
)

/* Right-hand HRMs. */
ZMK_HOLD_TAP(hmr,
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_L THUMBS>;
    hold-trigger-on-release;
)

/ {
      combos {
        compatible = "zmk,combos";

        to_base {
            bindings = <&to DEFAULT>;
            key-positions = <5 6>;
        };

        to_sym {
            bindings = <&to SYM>;
            key-positions = <1 2>;
        };

        to_num {
            bindings = <&to NUM>;
            key-positions = <1 3>;
        };

        to_nav {
            bindings = <&to NAV>;
            key-positions = <1 4>;
        };

        to_fn {
            bindings = <&to FN>;
            key-positions = <1 5>;
        };
    };
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// | ESC  |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
// | TAB  |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | GLOBE |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ENT  |
//                    | NUM | GUI | ENT |   | SPC | SYM  | NAV |
                        display-name = "Base";
                        bindings = <
   &kp ESC     &kp Q        &kp W       &kp E         &kp R       &kp T   &kp Y &kp U         &kp I              &kp O         &kp P            &kp BSPC
   &kp TAB     &kp A        &kp S       &kp D         &kp F       &kp G   &kp H &kp J         &kp K              &kp L         &kp SEMI         &kp SQT
   &kp GLOBE   &hml LCTRL Z &hml LALT X &hml LSHIFT C &hml LGUI V &kp B   &kp N &hmr RGUI M   &hmr RSHIFT COMMA  &hmr RALT DOT &hmr RCTRL FSLH  &kp ENTER
                                   &kp LGUI &kp ENTER &num_word NUM   &mo SYM &kp SPACE &mo NAV
                        >;
                };

                sym_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
// | CTRL |     |  ~  |  `  |     |  _  |   |  =  |  -  |  +  |  {  |  }  |  \   |
// | SHFT |     |     |     |     |     |   |     | "|" |     |  [  |  ]  |  ENT |
//                    | NUM | GUI | ENT |   | SPC | SYM  | NAV |
                        display-name = "Symbols";
                        bindings = <
   &kp  TAB  &kp EXCL &kp AT   &kp HASH  &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTERISK  &kp LPAR &kp RPAR &kp BSPC
   &kp LCTRL &none   &kp TILDE &kp GRAVE &none    &kp UNDER   &kp EQUAL &kp MINUS &kp PLUS      &kp LBKT &kp RBKT &kp BSLH
   &kp LSHFT &none   &none     &none     &none    &none       &none     &kp PIPE  &none         &kp LBRC &kp RBRC &trans
                               &trans    &trans   &trans      &trans    &trans    &trans
                        >;
                };

                num_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
// | CTRL |     |     |     |     |     |   |  *  |  4  |  5  |  6  |  +  |  =   |
// | SHFT |     |     |     |     |     |   |  /  |  1  |  2  |  3  |  -  | ENT  |
//                    | NUM | GUI | ENT |   | RET |  0  |  .  |
                        display-name = "Num";
                        bindings = <
   &kp TAB   &kp N1  &kp N2 &kp N3   &kp N4   &kp N5    &kp N6          &kp KP_N7  &kp KP_N8  &kp KP_N9 &kp N0       &kp BSPC
   &kp LCTRL &trans  &trans &trans   &trans   &trans    &kp KP_MULTIPLY &kp KP_N4  &kp KP_N5  &kp KP_N6 &kp KP_PLUS  &kp KP_EQUAL
   &kp LSHFT &trans  &trans &trans   &trans   &trans    &kp KP_SLASH    &kp KP_N1  &kp KP_N2  &kp KP_N3 &kp KP_MINUS &kp KP_ENTER
                            &trans   &trans   &trans    &kp RET   &kp KP_N0    &kp KP_DOT
                        >;
                };

                nav_layer {
// -----------------------------------------------------------------------------------------
// |      |     |     |     |     |     |   |     | PGUP | HOME |     |     |      |
// |      |     |     |     |     |     |   | LFT | DWN  | UP   | RGT |     |      |
// |      |     |     |     |     |     |   |     | PGDN | END  |     |     |      |
//                    | NUM | GUI | ENT |   | RET | SYM  | NAV  |
                        display-name = "Nav";
                        bindings = <
   &trans     &trans       &trans       &trans       &trans       &trans         &trans   &kp PG_UP   &kp HOME &trans    &trans &trans
   &trans     &trans       &trans       &trans       &trans       &trans         &kp LEFT &kp DOWN    &kp UP   &kp RIGHT &trans &trans
   &trans     &trans       &trans       &trans       &trans       &trans         &trans   &kp PG_DN   &kp END  &trans    &trans &trans
                                        &trans       &trans       &trans         &kp RET  &trans   &trans
                        >;
                };

                function_layer {
// -----------------------------------------------------------------------------------------
// |       | BT1 | BT2  | BT3  | BT4  | BT5 |   |    | F1  | F2  | F3  | F4  |    |
// | BR-   | BR+ | MUTE | VOL- | VOL+ |     |   |    | F5  | F6  | F7  | F8  |    |
// | BTCLR |     | REW  | PP   |  FF  |     |   |    | F9  | F10 | F11 | F12 |    |
//                       | NUM | GUI | ENT |   | SPC | SYM  | NAV |
                        display-name = "Fn";
                        bindings = <
   &none        &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2     &bt BT_SEL 3 &bt BT_SEL 4   &none  &kp F1 &kp F2  &kp F3  &kp F4  &none
   &kp C_BRI_DN &kp C_BRI_UP &kp C_MUTE   &kp C_VOL_DN     &kp C_VOL_UP &none          &none  &kp F5 &kp F6  &kp F7  &kp F8  &none
   &bt BT_CLR   &none        &kp C_PREV   &kp C_PLAY_PAUSE &kp C_NEXT   &none          &none  &kp F9 &kp F10 &kp F11 &kp F12 &none
                                          &trans           &trans       &trans         &trans  &trans   &trans
                        >;
                };
        };
};
