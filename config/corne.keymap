#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <behaviors/num_word.dtsi>
#include <zmk-helpers/helper.h>
#include "zmk-helpers/key-labels/42.h"

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2
// Layers
#define DEFAULT 0
#define SYM     1
#define NUM     2
#define NAV     3
#define FN      4
#define SYS     5

#define XXX &none
#define ___ &trans

/* Left-hand HRMs. */
ZMK_HOLD_TAP(hml,
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_R THUMBS>;
    hold-trigger-on-release;
)

/* Right-hand HRMs. */
ZMK_HOLD_TAP(hmr,
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_L THUMBS>;
    hold-trigger-on-release;
)

// TODO: Add more combos
// TODO: Magic Shift
// TODO: SMART_NUM
// TODO: Mouse Layer

/ {
      combos {
        compatible = "zmk,combos";

        to_base {
            bindings = <&to DEFAULT>;
            key-positions = <5 6>;
        };

        to_sym {
            bindings = <&to SYM>;
            key-positions = <1 2>;
        };

        to_num {
            bindings = <&to NUM>;
            key-positions = <1 3>;
        };

        to_nav {
            bindings = <&to NAV>;
            key-positions = <1 4>;
        };

        to_fn {
            bindings = <&to FN>;
            key-positions = <1 5>;
        };

        to_sys {
            bindings = <&to SYS>;
            key-positions = <0 5>;
        };
    };
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "Base";
                        bindings = <
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &kp ESC       &kp Q         &kp W         &kp E         &kp R         &kp T           &kp Y         &kp U         &kp I         &kp O         &kp P         &kp BSPC
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp TAB       &kp A         &kp S         &kp D         &kp F         &kp G           &kp H         &kp J         &kp K         &kp L         &kp SEMI      &kp SQT
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp GLOBE     &hml LCTRL Z  &hml LALT X   &hml LSHIFT C &hml LGUI V   &kp B           &kp N       &hmr RGUI M &hmr RSHIFT COMMA &hmr RALT DOT &hmr RCTRL FSLH &kp ENTER
//╰─────────────┴─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┴─────────────┴─────────────┴─────────────╯
                                              &mo FN        &kp ENTER     &num_word NUM   &mo SYM       &kp SPACE     &mo NAV
//                                          ╰─────────────┴─────────────┴─────────────╯ ╰─────────────┴─────────────┴─────────────╯
                        >;
                };

                sym_layer {
// -----------------------------------------------------------------------------------------
// |  DEF  |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
// | TAB   |     |  ~  |  `  |     |  _  |   |  =  |  -  |  +  |  {  |  }  |  \   |
// | GLOBE |     |     |     |     |     |   |     | "|" |     |  [  |  ]  |  ENT |
//                    | GUI | ENT | NUM |   | SPC | SYM  | NAV |
                        display-name = "Symbols";
                        bindings = <
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &to DEFAULT   &kp EXCL      &kp AT        &kp HASH      &kp DLLR      &kp PRCNT       &kp CARET     &kp AMPS      &kp ASTERISK  &kp LPAR      &kp RPAR      &kp BSPC
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    ___           XXX           &kp TILDE     &kp GRAVE     XXX           &kp UNDER       &kp EQUAL     &kp MINUS     &kp PLUS      &kp LBKT      &kp RBKT      &kp BSLH
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    ___           &kp LCTRL     &kp LALT      &kp LSHIFT    &kp LGUI      XXX             XXX           &kp PIPE      XXX           &kp LBRC      &kp RBRC      ___
//╰─────────────┴─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┴─────────────┴─────────────┴─────────────╯
                                              ___           ___           ___             ___           ___           ___
//                                          ╰─────────────┴─────────────┴─────────────╯ ╰─────────────┴─────────────┴─────────────╯
                        >;
                };

                num_layer {
// -----------------------------------------------------------------------------------------
// | BASE  |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
// | TAB   |     |     |     |     |     |   |  *  |  4  |  5  |  6  |  +  |  =   |
// | GLOBE |     |     |     |     |     |   |  /  |  1  |  2  |  3  |  -  | ENT  |
//                    | GUI | ENT | NUM |   | RET |  0  |  .  |
                        display-name = "Num";
                        bindings = <
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &to DEFAULT   &kp N1        &kp N2        &kp N3        &kp N4        &kp N5          &kp N6        &kp KP_N7     &kp KP_N8     &kp KP_N9     &kp N0        &kp BSPC
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    ___           ___           ___           ___           ___           ___           &kp KP_MULTIPLY &kp KP_N4     &kp KP_N5     &kp KP_N6     &kp KP_PLUS   &kp KP_EQUAL
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    ___           &kp LCTRL     &kp LALT      &kp LSHIFT    &kp LGUI      ___             &kp KP_SLASH  &kp KP_N1     &kp KP_N2     &kp KP_N3     &kp KP_MINUS  &kp KP_ENTER
//╰─────────────┴─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┴─────────────┴─────────────┴─────────────╯
                                              ___           ___           ___             &kp RET       &kp KP_N0     &kp KP_DOT
//                                          ╰─────────────┴─────────────┴─────────────╯ ╰─────────────┴─────────────┴─────────────╯
                        >;
                };

                nav_layer {
// -----------------------------------------------------------------------------------------
// |      |     |     |     |     |     |   |     | PGUP | HOME |     |     |      |
// |      |     |     |     |     |     |   | LFT | DWN  | UP   | RGT |     |      |
// |      |     |     |     |     |     |   |     | PGDN | END  |     |     |      |
//                    | GUI | ENT | NUM |   | SPC | SYM  | NAV |
                        display-name = "Nav";
                        bindings = <
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &to DEFAULT   ___           ___           ___           ___           ___             ___           &kp PG_UP     &kp HOME      ___           ___           ___
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    ___           ___           ___           ___           ___           ___             &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT     ___           ___
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    ___           &kp LCTRL     &kp LALT      &kp LSHIFT    &kp LGUI      ___             ___           &kp PG_DN     &kp END       ___           ___           ___
//╰─────────────┴─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┴─────────────┴─────────────┴─────────────╯
                                              ___           ___           ___             ___           ___           ___
//                                          ╰─────────────┴─────────────┴─────────────╯ ╰─────────────┴─────────────┴─────────────╯
                        >;
                };

                function_layer {
                        display-name = "Fn";
                        bindings = <
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &to DEFAULT   &kp C_PREV    &kp C_NEXT    &kp C_BRI_DN  &kp C_BRI_UP  XXX             XXX           &kp F1        &kp F2        &kp F3        &kp F4        XXX
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    ___       &kp C_PLAY_PAUSE  &kp C_MUTE    &kp C_VOL_DN  &kp C_VOL_UP  XXX             XXX           &kp F5        &kp F6        &kp F7        &kp F8        XXX
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    ___           &kp LCTRL     &kp LALT      &kp LSHIFT    &kp LGUI      XXX             XXX           &kp F9        &kp F10       &kp F11       &kp F12       XXX
//╰─────────────┴─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┴─────────────┴─────────────┴─────────────╯
                                              ___           ___           ___             ___           ___           ___
//                                          ╰─────────────┴─────────────┴─────────────╯ ╰─────────────┴─────────────┴─────────────╯
                        >;
                };

                sys_layer {
                        display-name = "System";
                        bindings = <
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &to DEFAULT   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 5  &bt BT_SEL 6  &bt BT_SEL 7  &bt BT_SEL 8  &bt BT_SEL 9  XXX
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    XXX          &bt BT_DISC 0 &bt BT_DISC 1 &bt BT_DISC 2 &bt BT_DISC 3 &bt BT_DISC 4   &bt BT_DISC 5 &bt BT_DISC 6 &bt BT_DISC 7 &bt BT_DISC 8 &bt BT_DISC 9  XXX
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &bt BT_CLR    XXX           XXX           XXX           &bootloader   &sys_reset      &sys_reset    &bootloader   XXX           XXX           XXX           XXX
//╰─────────────┴─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┴─────────────┴─────────────┴─────────────╯
                                              ___           ___           ___             ___           ___           ___
//                                          ╰─────────────┴─────────────┴─────────────╯ ╰─────────────┴─────────────┴─────────────╯
                        >;
                };
        };
};
