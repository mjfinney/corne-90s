#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <behaviors/num_word.dtsi>

#define DEFAULT 0
#define SYM     1
#define NUM     2
#define NAV     3
#define FN      4

/ {
      combos {
        compatible = "zmk,combos";

        to_base {
            bindings = <&to DEFAULT>;
            key-positions = <5 6>;
        };

        to_sym {
            bindings = <&to SYM>;
            key-positions = <1 2>;
        };

        to_num {
            bindings = <&to NUM>;
            key-positions = <1 3>;
        };

        to_nav {
            bindings = <&to NAV>;
            key-positions = <1 4>;
        };

        to_fn {
            bindings = <&to FN>;
            key-positions = <1 5>;
        };
    };
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// | TAB  |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
// | ESC  |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ENT  |
//                    | NUM | GUI | ENT |   | SPC | SYM  | NAV |
                        display-name = "Base";
                        bindings = <
   &kp TAB     &kp Q       &kp W      &kp E        &kp R      &kp T   &kp Y &kp U         &kp I       &kp O       &kp P          &kp BSPC
   &kp ESC     &mt LCTRL A &mt LALT S &mt LSHIFT D &mt LGUI F &kp G   &kp H &mt RGUI J  &mt RSHIFT K  &mt RALT L  &mt RCTRL SEMI &mt GLOBE SQT
   &kp GLOBE   &kp Z       &kp X      &kp C        &kp V      &kp B   &kp N &kp M         &kp COMMA   &kp DOT     &kp FSLH       &kp ENTER
                                         &num_word NUM &kp LGUI &kp ENTER   &kp SPACE &mo SYM &mo NAV
                        >;
                };

                sym_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
// | CTRL |     |  ~  |  `  |     |  _  |   |  =  |  -  |  +  |  {  |  }  |  \   |
// | SHFT |     |     |     |     |     |   |     | "|" |     |  [  |  ]  |  ENT |
//                    | NUM | GUI | ENT |   | SPC | SYM  | NAV |
                        display-name = "Symbols";
                        bindings = <
   &kp  TAB  &kp EXCL &kp AT   &kp HASH  &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTERISK  &kp LPAR &kp RPAR &kp BSPC
   &kp LCTRL &none   &kp TILDE &kp GRAVE &none    &kp UNDER   &kp EQUAL &kp MINUS &kp PLUS      &kp LBKT &kp RBKT &kp BSLH
   &kp LSHFT &none   &none     &none     &none    &none       &none     &kp PIPE  &none         &kp LBRC &kp RBRC &trans
                               &trans    &trans   &trans      &trans    &trans    &trans
                        >;
                };

                num_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
// | CTRL |     |     |     |     |     |   |  *  |  4  |  5  |  6  |  +  |  =   |
// | SHFT |     |     |     |     |     |   |  /  |  1  |  2  |  3  |  -  | ENT  |
//                    | NUM | GUI | ENT |   | RET |  0  |  .  |
                        display-name = "Num";
                        bindings = <
   &kp TAB   &kp N1  &kp N2 &kp N3   &kp N4   &kp N5    &kp N6          &kp KP_N7  &kp KP_N8  &kp KP_N9 &kp N0       &kp BSPC
   &kp LCTRL &trans  &trans &trans   &trans   &trans    &kp KP_MULTIPLY &kp KP_N4  &kp KP_N5  &kp KP_N6 &kp KP_PLUS  &kp KP_EQUAL
   &kp LSHFT &trans  &trans &trans   &trans   &trans    &kp KP_SLASH    &kp KP_N1  &kp KP_N2  &kp KP_N3 &kp KP_MINUS &kp KP_ENTER
                            &trans   &trans   &trans    &kp RET   &kp KP_N0    &kp KP_DOT
                        >;
                };

                nav_layer {
// -----------------------------------------------------------------------------------------
// |      |     |     |     |     |     |   |     | PGUP | HOME |     |     |      |
// |      |     |     |     |     |     |   | LFT | DWN  | UP   | RGT |     |      |
// |      |     |     |     |     |     |   |     | PGDN | END  |     |     |      |
//                    | NUM | GUI | ENT |   | RET | SYM  | NAV  |
                        display-name = "Nav";
                        bindings = <
   &trans     &trans       &trans       &trans       &trans       &trans         &trans   &kp PG_UP   &kp HOME &trans    &trans &trans
   &trans     &trans       &trans       &trans       &trans       &trans         &kp LEFT &kp DOWN    &kp UP   &kp RIGHT &trans &trans
   &trans     &trans       &trans       &trans       &trans       &trans         &trans   &kp PG_DN   &kp END  &trans    &trans &trans
                                        &trans       &trans       &trans         &kp RET  &trans   &trans
                        >;
                };

                function_layer {
// -----------------------------------------------------------------------------------------
// | BTCLR| BT1 | BT2  | BT3  | BT4  | BT5 |   |    | F1  | F2  | F3  | F4  |    |
// | BR-  | BR+ | MUTE | VOL- | VOL+ |     |   |    | F5  | F6  | F7  | F8  |    |
// | SHFT |     | REW  | PP   |  FF  |     |   |    | F9  | F10 | F11 | F12 |    |
//                       | NUM | GUI | ENT |   | SPC | SYM  | NAV |
                        display-name = "Fn";
                        bindings = <
   &bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2     &bt BT_SEL 3 &bt BT_SEL 4   &none  &kp F1 &kp F2  &kp F3  &kp F4  &none
   &kp C_BRI_DN &kp C_BRI_UP &kp C_MUTE   &kp C_VOL_DN     &kp C_VOL_UP &none          &none  &kp F5 &kp F6  &kp F7  &kp F8  &none
   &kp LSHFT    &none        &kp C_PREV   &kp C_PLAY_PAUSE &kp C_NEXT   &none          &none  &kp F9 &kp F10 &kp F11 &kp F12 &none
                                          &trans           &trans       &trans         &trans  &trans   &trans
                        >;
                };
        };
};
